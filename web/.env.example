# 이 파일을 .env.local로 복사하고 값을 채운다 (.env.local은 git에 올라가지 않음)
# Supabase 대시보드 → Project Settings → API Keys 에서 확인

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# 백엔드(FastAPI, api/) 주소. 서버에서만 쓴다 (브라우저에 노출 안 됨). 로컬 기본값은 아래와 같다
# API_URL=http://localhost:8000

# 배포할 때만: 가입 확인 메일 링크가 돌아올 사이트 주소 (로컬에서는 비워 둠)
# NEXT_PUBLIC_SITE_URL=https://serieskeeper.vercel.app
