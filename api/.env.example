# 백엔드 설정. 이 파일을 api/.env로 복사하고 값을 채운다 (.env는 git에 올라가지 않음)

# Supabase 대시보드 → Project Settings → API Keys 의 Project URL (웹과 같은 값)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# 웹과 같은 Publishable key (비밀 값 아님). Storage 서명 URL을 만들 때 쓴다
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Postgres 접속 주소. Supabase 대시보드 → 상단 Connect → Transaction pooler (포트 6543)
# [YOUR-PASSWORD]는 DB 비밀번호로 바꾼다 (잊었으면 Project Settings → Database에서 재설정)
# 관리자 키처럼 다뤄야 한다: 웹(web/.env)이나 코드에 절대 넣지 말 것
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# 이 백엔드를 부를 수 있는 웹 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:3000
