# 분석 워커 설정. 이 파일을 pipeline/.env로 복사하고 값을 채운다 (.env는 git에 올라가지 않음)
# Supabase 대시보드 → Project Settings → API Keys

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Secret key (sb_secret_...). RLS를 건너뛰는 관리자 키다.
# 절대 웹(web/.env)이나 브라우저 코드에 넣지 말 것. 유출되면 대시보드에서 바로 폐기하고 새로 만든다.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# 분석 대기 회차를 확인하는 간격(초)
WORKER_POLL_SECONDS=5
